PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/farmdirect

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

AI_SERVICE_URL=http://localhost:8000

CORS_ORIGIN=http://localhost:5173

# SMS notifications (see FarmDirect_SMS_Notification_Plan.txt)
# provider "mock" (default) logs SMS to the console instead of sending real
# messages — use this until a real provider account is set up.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=FARMDR
SMS_API_URL=
